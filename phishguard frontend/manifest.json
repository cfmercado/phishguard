{
    "manifest_version": 3,
    "name": "PhishGuard Extension",
    "short_name": "PhishGuard",
    "version": "1.0",
    "key": "",
    "author": "Cedric Allen F. Mercado <cfmercado@up.edu.ph>",

    "description": "Manifest V3-Compliant Phishing Detection System using CatBoost",

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [ "*://mail.google.com/*" ],
            "js": [
                "src/extensionInjector.js"
            ],
            "css": [
                "src/style.css"
            ],
            "run_at": "document_start"
        }
    ],

    "web_accessible_resources": [{
        "resources": [
            "dist/gmailJsLoader.js",
            "dist/extension.js",
            "dist/gmailJsLoader.js.map",
            "dist/extension.js.map"
        ],
        "matches": ["https://mail.google.com/*"]
    }],
    "host_permissions": [
        "https://mail.google.com/*",
        "http://localhost:8000/*",
        "https://phishguard-backend-1qg5.onrender.com/*"
    ]
}
